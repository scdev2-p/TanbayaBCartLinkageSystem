left join [tnb].[dbo].M_仕入先 ss on ss.仕入先コード = mp.仕入先コード and ss.仕入先履歴番号 = mp.仕入先履歴番号
left join [tnb].[dbo].M_フロア mf on mf.フロアコード = mp.フロアコード
